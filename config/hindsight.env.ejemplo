# Copiar a ~/.config/fabrica/hindsight.env (chmod 600) y poner la clave de DeepSeek.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=es
HINDSIGHT_API_LLM_MAX_CONCURRENT=4
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_DATABASE_URL=pg0
HINDSIGHT_API_WORKER_MAX_SLOTS=4
# Sin esto PyTorch abre un hilo por núcleo en cada tarea y satura la máquina
OMP_NUM_THREADS=3
MKL_NUM_THREADS=3
OPENBLAS_NUM_THREADS=3
TOKENIZERS_PARALLELISM=false
HF_HOME=/home/CAMBIAR_USUARIO/.local/share/fabrica/hf   # ruta absoluta (systemd no expande variables)
